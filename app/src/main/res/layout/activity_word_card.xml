<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#232429"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="358dp"
        android:layout_height="658dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="70dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="40dp"
            android:text="Карточка слова"
            android:textColor="#FB9901"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- Поля ввода -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TextInput.Outlined.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_word"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:hint="Слово"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#A0A0A0" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TextInput.Outlined.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_translation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:hint="Перевод"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#A0A0A0" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TextInput.Outlined.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_example"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:hint="Пример"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#A0A0A0" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#A0A0A0"
            android:textSize="14sp" />

        <!-- Пространство -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <!-- Кнопки -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Сохранить"
            android:textColor="#FFFFFF"
            app:backgroundTint="#FB9901" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/Widget.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Удалить"
            android:textColor="#A0A0A0"
            app:backgroundTint="#26262D" />

    </LinearLayout>

</LinearLayout>