<!-- res/values/themes.xml -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SpeakEasy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <style name="Theme.SpeakEasy" parent="Base.Theme.SpeakEasy" />

    <!-- Стили кнопок -->
    <style name="Widget.TextInput.Outlined.Rounded" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">#3A3A4A</item>
        <item name="hintTextColor">#A0A0A0</item>
    </style>

    <style name="Widget.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">#FB9901</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Widget.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">#3A3A4A</item>
        <item name="android:textColor">#A0A0A0</item>
    </style>


</resources>